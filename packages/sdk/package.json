{
  "name": "@zilijonas/foliark",
  "version": "0.1.2",
  "description": "Rust/WebAssembly PDF SDK for the browser: extract text, render, edit, redact and sanitize PDFs offline. A PyMuPDF alternative. AGPL-3.0.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Linas Jonas Zilinskas",
  "homepage": "https://github.com/zilijonas/foliark#readme",
  "bugs": { "url": "https://github.com/zilijonas/foliark/issues" },
  "keywords": ["pdf", "pdf-redaction", "redact", "pdf-editor", "pdf-text-extraction", "pdf-render", "pdf-sanitize", "webassembly", "wasm", "rust", "pymupdf-alternative", "privacy", "offline", "browser", "typescript"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/zilijonas/foliark.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./worker": { "types": "./dist/worker.d.ts", "default": "./dist/worker.js" },
    "./inline": { "types": "./dist/inline.d.ts", "default": "./dist/inline.js" },
    "./wasm": "./wasm/foliark_wasm_bg.wasm",
    "./cmaps/*": "./cmaps/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "cmaps",
    "README.md",
    "LICENSE",
    "LICENSING.md",
    "COMMERCIAL-LICENSING.md",
    "LICENSE_FOXIT",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SUPPORT_MATRIX.md"
  ],
  "sideEffects": [
    "./dist/worker.js"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "prepack": "cp ../../LICENSE LICENSE && cp ../../LICENSING.md LICENSING.md && cp ../../COMMERCIAL-LICENSING.md COMMERCIAL-LICENSING.md && cp ../../vendor/hayro-interpret/assets/LICENSE_FOXIT LICENSE_FOXIT && cp ../../docs/support-matrix.md SUPPORT_MATRIX.md && node ../../scripts/gen-notices.mjs --check && test -f wasm/foliark_wasm_bg.wasm && test -f dist/index.js"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
